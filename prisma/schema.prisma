generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  nombre          String
  apellido        String
  activo          Boolean          @default(true)
  rolId           String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  categoriasGasto CategoriaGasto[]
  eventos         Evento[]
  gastos          Gasto[]
  ingresos        Ingreso[]
  listasTareas    ListaTarea[]
  pushTokens      PushToken[]
  recordatorios   Recordatorio[]
  tareas          Tarea[]
  role            Rol              @relation(fields: [rolId], references: [id])
}

model Rol {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  permisos    RolPermiso[]
  usuarios    Usuario[]
}

model Permiso {
  id          String       @id @default(uuid())
  codigo      String       @unique
  descripcion String?
  roles       RolPermiso[]
}

model RolPermiso {
  id        String  @id @default(uuid())
  rolId     String
  permisoId String
  permiso   Permiso @relation(fields: [permisoId], references: [id])
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([rolId, permisoId])
}

model Evento {
  id            String         @id @default(uuid())
  usuarioId     String
  titulo        String
  descripcion   String?
  ubicacion     String?
  direccion     String?
  inicio        DateTime
  todoElDia     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  activo        Boolean        @default(true)
  estado        EstadoTarea    @default(PENDIENTE)
  prioridad     Prioridad      @default(MEDIA)
  hora          String?
  link          String?
  gastoTotal    Decimal?       @db.Decimal(10, 2)
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  gastos        Gasto[]
  recordatorios Recordatorio[]
}

model ListaTarea {
  id               String         @id @default(uuid())
  usuarioId        String
  titulo           String
  descripcion      String?
  tipoPeriodo      TipoPeriodo    @default(CUSTOM)
  gastoTotal       Decimal?       @db.Decimal(10, 2)
  estado           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  categoriaGastoId String
  mes              Int
  anio             Int
  fin              DateTime?
  inicio           DateTime?
  gastos           Gasto[]
  categoriaGasto   CategoriaGasto @relation(fields: [categoriaGastoId], references: [id])
  usuario          Usuario        @relation(fields: [usuarioId], references: [id])
  recordatorios    Recordatorio[]
  tareas           Tarea[]
}

model Tarea {
  id               String         @id @default(uuid())
  listaTareaId     String?
  titulo           String
  descripcion      String?
  fechaVencimiento DateTime?
  estado           EstadoTarea    @default(PENDIENTE)
  prioridad        Prioridad      @default(MEDIA)
  gasto            Decimal?       @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  usuarioId        String
  gastos           Gasto[]
  items            ItemTarea[]
  recordatorios    Recordatorio[]
  listaTarea       ListaTarea?    @relation(fields: [listaTareaId], references: [id], onDelete: Restrict)
  usuario          Usuario        @relation(fields: [usuarioId], references: [id])
}

model ItemTarea {
  id         String   @id @default(uuid())
  tareaId    String
  texto      String
  completado Boolean  @default(false)
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tarea      Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@index([tareaId])
}

model CategoriaGasto {
  id           String       @id @default(uuid())
  usuarioId    String
  nombre       String
  descripcion  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])
  gastos       Gasto[]
  listasTareas ListaTarea[]
}

model Gasto {
  id               String         @id @default(uuid())
  usuarioId        String
  categoriaGastoId String
  listaTareaId     String?
  eventoId         String?
  total            Decimal        @db.Decimal(10, 2)
  descripcion      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  tareaId          String?
  anio             Int
  mes              Int
  completado Boolean  @default(false)
  categoriaGasto   CategoriaGasto @relation(fields: [categoriaGastoId], references: [id])
  evento           Evento?        @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  listaTarea       ListaTarea?    @relation(fields: [listaTareaId], references: [id], onDelete: Restrict)
  tarea            Tarea?         @relation(fields: [tareaId], references: [id], onDelete: Restrict)
  usuario          Usuario        @relation(fields: [usuarioId], references: [id])
}

model Ingreso {
  id        String    @id @default(uuid())
  usuarioId String
  total     Decimal   @db.Decimal(10, 2)
  concepto  String
  mes       Int
  anio      Int
  fecha     DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
}

model Recordatorio {
  id           String             @id @default(uuid())
  usuarioId    String
  eventoId     String?
  tareaId      String?
  activador    DateTime           @db.Timestamptz(3)
  estado       EstadoRecordatorio @default(PENDIENTE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  listaTareaId String?
  evento       Evento?            @relation(fields: [eventoId], references: [id])
  listaTarea   ListaTarea?        @relation(fields: [listaTareaId], references: [id])
  tarea        Tarea?             @relation(fields: [tareaId], references: [id])
  usuario      Usuario            @relation(fields: [usuarioId], references: [id])
}

model PushToken {
  id              String          @id @default(uuid())
  usuarioId       String
  token           String          @unique
  tipoDispositivo TipoDispositivo
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
}

enum EstadoTarea {
  PENDIENTE
  COMPLETADA
  CANCELADA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

enum TipoPeriodo {
  SEMANAL
  MENSUAL
  CUSTOM
}

enum EstadoRecordatorio {
  PENDIENTE
  ENVIADO
  CANCELADO
  ACTUALIZADO
}

enum TipoDispositivo {
  ANDROID
  IOS
  WEB
}
